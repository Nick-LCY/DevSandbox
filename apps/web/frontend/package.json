{
  "name": "@sandbox-platform/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "沙箱平台网页控制台前端：沙箱列表 / 新建沙箱 / 沙箱详情与网页终端 / 代理设置",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fonts": "bash scripts/build-fonts.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:acceptance": "playwright test --config=tests/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.7"
  }
}
