{
  "name": "@sandbox-platform/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "沙箱平台端到端测试基建：静态页可达冒烟 + 健康检查门禁 + 契约断言",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "pnpm run test:scripted",
    "test:scripted": "playwright test --project=scripted",
    "gate": "bash tools/assert-contracts.sh",
    "install:deps": "bash tools/install-deps.sh",
    "services:up": "bash tools/start-services.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@playwright/test": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
