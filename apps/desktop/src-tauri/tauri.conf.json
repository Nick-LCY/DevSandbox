{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "沙箱控制台",
  "version": "0.1.0",
  "identifier": "com.sandbox-platform.console",
  "build": {
    "frontendDist": "../../web/frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../web/frontend dev",
    "beforeBuildCommand": "pnpm --dir ../web/frontend build"
  },
  "app": {
    // 主窗口**不在这里配**：窗口由 src/main.rs 的 WebviewWindowBuilder 创建
    // （on_web_resource_request 只能在 webview 创建时挂上，运行期换不了 CSP）。
    // **不要在这里加回 app.windows**：会开出第二个窗口。
    "security": {
      // 基线策略；connect-src 只有 'self'——后端主机是运行期才知道的，
      // 由 Rust 侧在主文档被请求时按当前后端主机补进去（见 src/csp.rs）。
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
