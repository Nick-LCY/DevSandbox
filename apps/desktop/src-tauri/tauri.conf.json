{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "沙箱控制台",
  "version": "0.1.0",
  "identifier": "com.sandbox-platform.console",
  "build": {
    "frontendDist": "../../web/frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../web/frontend dev",
    "beforeBuildCommand": "pnpm --dir ../web/frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "沙箱控制台",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
