# Terraform 远端状态后端配置模板（S3 兼容对象存储 = MinIO）。
#
# 用法：
#   cp backend.hcl.example backend.hcl   # backend.hcl 不入库（.gitignore 已忽略）
#   # 把下面的占位值替换成真实值（**待用户提供**）
#   terraform init                        # 初始化后端（需要 AWS_* 凭据环境变量）
#
# ⚠️ 本文件**全部是占位值**，直接拿去 init 会失败——这是有意为之：
#    凭据与端点信息尚未到位（见 README「待用户提供」清单）。

# MinIO 桶名（远端状态所在桶）。待用户提供。
bucket = "console-cloudflare-tfstate"

# 状态对象键——**字面量，不含 <workspace> 占位符**。
#
# workspace 隔离**不靠 key**、靠下方的 `workspace_key_prefix`：S3 后端把它**前置**到 key
# **之前**（不是追加在 key 之后）：
#   default workspace  ⇒ 对象 = "<key>"                      = "console-cloudflare/terraform.tfstate"
#   非 default workspace ⇒ 对象 = "<prefix>/<workspace>/<key>" = "envs/dev/console-cloudflare/terraform.tfstate"
# 本项目是「单 root module + workspace」用法，不做多环境矩阵；不同 workspace 按此前缀隔离。
# 待用户提供（桶名 / 路径前缀）。
key = "console-cloudflare/terraform.tfstate"

# workspace 状态对象的路径前缀（**前置**到 key 之前）。后端默认值为 "env:"，这里显式改成
# "envs"，避免默认值随版本漂移、也让状态对象路径一眼可读。
workspace_key_prefix = "envs"

# 区域。MinIO 不校验区域，任意稳定值即可（通常填 us-east-1）。待用户提供。
region = "us-east-1"

# MinIO 端点 URL。待用户提供（示例：https://minio.sankabox.com —— 尚未确认）。
endpoint = "https://minio.sankabox.com"

# MinIO 必须用 path style：否则桶名会被当成域名的一部分（bucket.minio.host），
# MinIO 侧解析不到，直接 404 / SignatureDoesNotMatch。
use_path_style = true

# ── 以下四个 skip_* 是 MinIO（非 AWS）的硬要求 ──────────────────────────────
# 不设它们，terraform init 会去 AWS 官方端点做凭证 / 区域 / 账号校验，
# 直接卡住（连不上 AWS metadata 服务、报 NoCredentialProviders 等）。
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true

# 老版本 MinIO 不认 S3 的 `x-amz-checksum-mode` 头，会直接回 400 ⇒ 预置关闭 checksum。
# （目标 MinIO 已支持该头时可删掉本行。）
skip_s3_checksum = true
